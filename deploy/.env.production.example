# FR8-8 — production .env template. Copy to <main-project>/.env on the VPS and
# fill in the blanks. This file is a template only: it must never hold real
# credentials, and the real .env is never committed or shipped by the pipeline.

APP_NAME="SMK PGRI Telagasari"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smkpgritelagasari.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# NFR-9: HTTPS is mandatory in production, so the session cookie must be
# secure-only and unreadable from JavaScript.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# FR6-1 — SSR is on in production. Turning this off is a defect, not a tuning
# knob; the flag exists for the test suite (see phpunit.xml).
INERTIA_SSR_ENABLED=true

# OQ8-3 — leave as log until the school confirms an SMTP account.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@smkpgritelagasari.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

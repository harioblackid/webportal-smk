{
    "$schema": "https://www.schemastore.org/package.json",
    "version": "1.5.2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "test:e2e": "node scripts/e2e-clean-hot.mjs && playwright test --grep-invert @perf",
        "test:e2e:ci": "node scripts/e2e-clean-hot.mjs && playwright test --project=seo --project=chromium --project=webkit tests/e2e/cross/seo.spec.ts tests/e2e/cross/smoke.spec.ts",
        "test:e2e:db": "node scripts/e2e-db.mjs",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "format": "prettier --write resources/ \"tests/e2e/**/*.ts\" playwright.config.ts",
        "format:check": "prettier --check resources/ \"tests/e2e/**/*.ts\" playwright.config.ts",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "test:e2e:perf": "node scripts/e2e-clean-hot.mjs && playwright test --project=perf --workers=1"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "fontaine": "^0.8.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-toggle": "^1.1.18",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.1.11",
        "@tiptap/extension-image": "^3.30.3",
        "@tiptap/pm": "^3.30.3",
        "@tiptap/react": "^3.30.3",
        "@tiptap/starter-kit": "^3.30.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "globals": "^15.14.0",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^1.34.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
